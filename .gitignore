# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
infra/.build/

# Contains your email and Discord IDs
terraform.tfvars
*.auto.tfvars

# EC2 key pairs -- these decrypt the Windows Administrator password
*.pem
*.ppk

# Lambda build output, regenerated by bot\build.ps1
bot/build/
__pycache__/
*.pyc

# Never commit a real server password
server/serverSettings.local.lua

# DCS missions are large binaries; keep them in S3 or a release, not in git
*.miz

# OS
Thumbs.db
desktop.ini
.DS_Store

# Saved plan files. BOTH patterns matter: `terraform plan -out=tfplan` writes a
# file with no extension, which *.tfplan does not match, and a plan file carries
# full resource attributes including sensitive ones.
*.tfplan
tfplan
infra/tfplan

# Real values for the placeholders used in this repo -- never commit
REAL-VALUES.md
*.local.md
